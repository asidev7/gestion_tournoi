[Unit]
Description=Gunicorn pour ADEIB U26 (tournoi-adeib.site)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/tournoi-adeib
EnvironmentFile=/var/www/tournoi-adeib/.env
ExecStart=/var/www/tournoi-adeib/venv/bin/gunicorn \
    --workers 3 \
    --bind unix:/run/gunicorn-tournoi.sock \
    --access-logfile - \
    --error-logfile - \
    config.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
