# Variables d'environnement de PRODUCTION
# Copier ce fichier en .env sur le VPS : cp deploy/.env.example .env
# Puis remplir DJANGO_SECRET_KEY (voir DEPLOY.md pour générer une clé).
# Ne JAMAIS committer le vrai .env dans Git.

DJANGO_SECRET_KEY=REMPLACER_PAR_UNE_CLE_SECRETE_GENEREE
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=tournoi-adeib.site,www.tournoi-adeib.site
DJANGO_CSRF_TRUSTED_ORIGINS=https://tournoi-adeib.site,https://www.tournoi-adeib.site

# Laisser True une fois le HTTPS (certbot) configuré.
# Mettre False UNIQUEMENT pendant la phase de test en HTTP, avant certbot.
DJANGO_SECURE_SSL_REDIRECT=True
